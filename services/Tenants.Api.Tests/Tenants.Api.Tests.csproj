    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <RootNamespace>Tenants.Api.Tests</RootNamespace>
    <AssemblyName>Tenants.Api.Tests</AssemblyName>
  </PropertyGroup>

  <!-- Les versions sont dans Directory.Packages.props, à la racine. -->
