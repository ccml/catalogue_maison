<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Metadata.Api</RootNamespace>
    <AssemblyName>Metadata.Api</AssemblyName>
    <Version>1.0.1</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Clé OMDb en développement : dotnet user-secrets, hors du dépôt. -->
    <UserSecretsId>cataloguemaison-metadata-api</UserSecretsId>
  </PropertyGroup>

  <!-- Les versions sont dans Directory.Packages.props, à la racine. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Metadata.Api.Tests" />
  </ItemGroup>

</Project>
